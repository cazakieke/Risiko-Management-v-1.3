<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Risikomanagement (DE) – Energieprojekte (LT/Umspannwerk/Thermo/Kohle→Gas)</title>

  <!-- Favicon placeholder (será atualizado via JS quando o logo for carregado) -->
  <link id="appFavicon" rel="icon" type="image/svg+xml"
    href='data:image/svg+xml;utf8,
    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64">
      <rect width="64" height="64" rx="14" fill="%230f1933"/>
      <path d="M38 8 18 36h12l-4 20 20-30H34l4-18z" fill="%2364b5f6"/>
      <text x="10" y="58" font-family="Arial" font-size="12" fill="%23bcd1ff">RM</text>
    </svg>' />

  <style>
    :root{
      --bg:#0b1220; --card:#111a2e; --muted:#9fb0d0; --text:#e9efff; --accent:#64b5f6;
      --good:#2ecc71; --warn:#f1c40f; --bad:#e67e22; --crit:#e74c3c;
      --line:#233255; --chip:#1a2542; --panel:#0b1327;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      --sans: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, "Noto Sans", "Liberation Sans", sans-serif;
    }

    body{ margin:0; font-family:var(--sans); background:linear-gradient(180deg,#070c16, var(--bg)); color:var(--text); }

    header{
      padding:14px 16px; border-bottom:1px solid var(--line);
      background:rgba(17,26,46,.75); backdrop-filter: blur(6px);
      position:sticky; top:0; z-index:10;
      display:flex; gap:12px; align-items:flex-start;
    }
    .brand{ display:flex; gap:10px; align-items:center; min-width:280px; }
    .logo{
      width:42px; height:42px; border-radius:12px; background:#0f1933; border:1px solid var(--line);
      overflow:hidden; display:grid; place-items:center; flex:0 0 auto;
    }
    .logo img{ width:100%; height:100%; object-fit:cover; display:none; }
    .logo svg{ width:26px; height:26px; display:block; }
    header h1{ margin:0; font-size:14px; font-weight:900; letter-spacing:.2px; }
    header .sub{ margin-top:4px; color:var(--muted); font-size:11px; line-height:1.35; max-width:980px; }

    main{ max-width:1250px; margin:0 auto; padding:14px 16px 22px; }

    .card{
      background:rgba(17,26,46,.85); border:1px solid var(--line); border-radius:12px;
      padding:14px; box-shadow: 0 8px 28px rgba(0,0,0,.25);
    }

    h2{ margin:0 0 10px 0; font-size:14px; }
    h3{ margin:10px 0 8px 0; font-size:13px; color:#dbe6ff; }
    .muted{ color:var(--muted); font-size:12px; line-height:1.45; }
    .small{ font-size:11px; color:var(--muted); line-height:1.35; }
    .mono{ font-family:var(--mono); font-size:11px; color:#cfe1ff; }

    .row{ display:flex; gap:10px; flex-wrap: wrap; align-items:flex-end; }
    label{ font-size:12px; color:#dbe6ff; }
    input[type="text"], input[type="date"], input[type="number"], select, textarea{
      background:var(--panel); color:var(--text); border:1px solid var(--line);
      border-radius:10px; padding:8px 10px; font-size:12px; outline:none;
    }
    input[type="number"]{ width:72px; }
    input[type="file"]{ color:var(--muted); font-size:12px; }

    button{
      background: linear-gradient(180deg, #2a6df4, #1d4ed8);
      border:1px solid rgba(100,181,246,.35); color:#fff;
      padding:9px 12px; border-radius:10px; cursor:pointer;
      font-size:12px; font-weight:900;
    }
    button.secondary{ background:var(--panel); border:1px solid var(--line); color:var(--text); font-weight:800; }
    button.tab{
      background:rgba(11,19,39,.7); border:1px solid rgba(35,50,85,.9); color:#cfe1ff;
      font-weight:900; padding:9px 12px;
    }
    button.tab.active{
      background:linear-gradient(180deg, rgba(100,181,246,.35), rgba(29,78,216,.35));
      border-color:rgba(100,181,246,.55); color:#ffffff;
    }
    .tabs{ display:flex; gap:8px; flex-wrap:wrap; margin-top:6px; }

    fieldset{ border:1px solid var(--line); border-radius:12px; padding:10px; margin:10px 0; }
    legend{ padding:0 8px; color:#dbe6ff; font-size:12px; font-weight:950; }

    .checks{ display:grid; grid-template-columns:1fr; gap:8px; }
    @media (min-width: 900px){ .checks{ grid-template-columns:1fr 1fr; } }

    .check{
      display:flex; gap:10px; align-items:flex-start;
      padding:9px 10px; border-radius:12px;
      background: rgba(10,16,32,.60); border:1px solid rgba(35,50,85,.75);
    }
    .check input{ margin-top:3px; transform: scale(1.05); }
    .check .t{ font-size:12px; line-height:1.25; font-weight:950; color:#e9efff; }
    .check .d{ margin-top:3px; font-size:11px; line-height:1.35; color:var(--muted); }
    .check .r{ margin-top:6px; font-size:11px; color:#bcd1ff; }
    .check .code{ margin-top:6px; font-size:11px; font-family:var(--mono); color:#cfe1ff; opacity:.9; }

    .chip{
      display:inline-block; background:var(--chip); border:1px solid rgba(35,50,85,.9);
      padding:2px 8px; border-radius:999px; font-size:11px; color:#dbe6ff;
      margin:2px 4px 0 0;
    }

    /* Tables: sticky header INSIDE scroll container (prevents overlap with global header) */
    .table-wrap{
      margin-top:10px; border:1px solid var(--line); border-radius:12px;
      overflow:auto; max-height: 560px; background: rgba(10,16,32,.35);
    }
    table{ width:100%; border-collapse:separate; border-spacing:0; min-width: 1120px; }
    th, td{ border-bottom:1px solid rgba(35,50,85,.8); padding:8px 8px; vertical-align:top; }
    th{
      position:sticky; top:0; z-index:2;
      background:#0f1933; font-size:11px; text-transform:uppercase;
      letter-spacing:.6px; color:#bcd1ff;
