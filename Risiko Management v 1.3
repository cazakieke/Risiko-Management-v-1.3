   ========================= */
function getSelectedFeatureSet(){
  const sel = new Set();
  FEATURES.forEach(f=>{
    const chk = document.getElementById("chk_"+f.id);
    if(chk && chk.checked) sel.add(f.id);
  });
  return sel;
}
function isApplicable(item, selected){
  const all = item.all || [];
  const any = item.any || [];
  const okAll = all.length ? all.every(x=>selected.has(x)) : true;
  const okAny = any.length ? any.some(x=>selected.has(x)) : true;
  return okAll && okAny;
}

/* =========================
   Risk scoring
   ========================= */
function riskLevel(score, preset="default"){
  if(preset==="conservative"){
    if(score>=16) return {lvl:"Kritisch", cls:"crit"};
    if(score>=9)  return {lvl:"Hoch", cls:"high"};
    if(score>=4)  return {lvl:"Mittel", cls:"med"};
    return {lvl:"Niedrig", cls:"low"};
  }
  if(score>=17) return {lvl:"Kritisch", cls:"crit"};
  if(score>=10) return {lvl:"Hoch", cls:"high"};
  if(score>=5)  return {lvl:"Mittel", cls:"med"};
  return {lvl:"Niedrig", cls:"low"};
}
function levelColor(level){
  switch(level){
    case "Kritisch": return [231,76,60];
    case "Hoch":     return [230,126,34];
    case "Mittel":   return [241,196,15];
    default:         return [46,204,113];
  }
}

/* =========================
   CPM
   ========================= */
function parsePred(pred){
  if(!pred) return [];
  if(Array.isArray(pred)) return pred;
  return String(pred).split(";").map(s=>s.trim()).filter(Boolean);
}
function computeCPM(appTasks){
  const map = new Map(appTasks.map(t=>[t.id, {...t, pred: parsePred(t.pred)}]));
  for(const t of map.values()) t.pred = t.pred.filter(p=>map.has(p));

  const succ = new Map();
  const indeg = new Map();
  for(const id of map.keys()){ succ.set(id, []); indeg.set(id, 0); }
  for(const t of map.values()){
    for(const p of t.pred){
      succ.get(p).push(t.id);
      indeg.set(t.id, indeg.get(t.id)+1);
    }
  }

  const q = [];
  for(const [id,deg] of indeg.entries()) if(deg===0) q.push(id);
  const topo = [];
  while(q.length){
    const id = q.shift();
    topo.push(id);
    for(const s of succ.get(id)){
      indeg.set(s, indeg.get(s)-1);
      if(indeg.get(s)===0) q.push(s);
    }
  }
  if(topo.length !== map.size){
    return { ok:false, error:"Zyklus in Vorgängerketten erkannt (CPM nicht berechenbar).", tasks:[...map.values()] };
  }

  for(const id of topo){
    const t = map.get(id);
    const es = t.pred.length ? Math.max(...t.pred.map(p=>map.get(p).EF)) : 0;
    t.ES = es; t.EF = es + Number(t.dur||0);
  }
  const projectDuration = Math.max(...[...map.values()].map(t=>t.EF), 0);

  for(const t of map.values()){
    t.LF = projectDuration; t.LS = projectDuration - Number(t.dur||0);
  }
  for(const id of topo.slice().reverse()){
    const t = map.get(id);
    const sids = succ.get(id) || [];
    if(sids.length){
      const lf = Math.min(...sids.map(sid => map.get(sid).LS));
      t.LF = lf; t.LS = lf - Number(t.dur||0);
    }
    t.Float = t.LS - t.ES;
    t.Critical = (t.Float === 0);
  }
  return { ok:true, tasks: topo.map(id=>map.get(id)), projectDuration };
}
function daysToDate(startDate, days){
  const d = new Date(startDate);
  d.setDate(d.getDate() + days);
  return d.toISOString().slice(0,10);
}

/* =========================
   SLA Engine (gate calibrated + anchored)
   ========================= */
function splitGates(g){ return String(g||"").split("/").map(s=>s.trim()).filter(Boolean); }
function primaryGate(g){ const gs = splitGates(g); return gs[0] || "FEL"; }
const LEVEL_OFFSET = { "Kritisch": -0.15, "Hoch": -0.10, "Mittel": 0.00, "Niedrig": +0.10 };

function buildDefaultGateWindows(projectDuration){
  const seg = { FEL:0.15, FEED:0.20, Detail:0.20, Proc:0.15, Const:0.25, Comm:0.05 };
  let acc = 0; const win = {};
  for(const g of ["FEL","FEED","Detail","Proc","Const","Comm"]){
    const start = Math.round(acc * projectDuration);
    const end = Math.round((acc + (seg[g]||0)) * projectDuration);
    win[g] = {start, end: Math.max(end, start+1)};
    acc += (seg[g]||0);
  }
  return win;
}
function computeGateWindowsFromCPM(cpm){
  const win = {};
  if(!cpm || !cpm.ok || !cpm.tasks?.length) return win;
  for(const t of cpm.tasks){
    for(const g of splitGates(t.gate)){
      if(!win[g]) win[g] = {start: Number.POSITIVE_INFINITY, end: 0};
      win[g].start = Math.min(win[g].start, t.ES ?? 0);
      win[g].end   = Math.max(win[g].end,   t.EF ?? 0);
    }
  }
  for(const [g,v] of Object.entries(win)){
    if(!Number.isFinite(v.start)) delete win[g];
    else if(v.end <= v.start) v.end = v.start + 1;
  }
  return win;
}
function getGateWindow(gate, gateWin, projectDuration){
  if(gateWin && gateWin[gate]) return gateWin[gate];
  const def = buildDefaultGateWindows(projectDuration || 1);
  return def[gate] || {start:0, end: Math.max(1, projectDuration||1)};
}
function clamp(min, x, max){ return Math.max(min, Math.min(max, x)); }
function computeDueDayForStep({gateStart, gateEnd, baseFraction, level}){
  const offset = LEVEL_OFFSET[level] ?? 0.0;
  const frac = clamp(0.05, baseFraction + offset, 0.95);
  const gateLen = Math.max(1, gateEnd - gateStart);
  const due = gateStart + Math.round(gateLen * frac);
  return clamp(gateStart, due, gateEnd);
}

function indexCPMTasks(cpm){
  const idx = new Map();
  if(!cpm || !cpm.ok) return idx;
  for(const t of (cpm.tasks||[])) idx.set(t.id, t);
  return idx;
}
function earliestAnchorES(taskIds, taskIndex){
  let best = null;
  for(const id of (taskIds||[])){
    const t = taskIndex.get(id);
    if(!t) continue;
    if(best===null || (t.ES < best.es)) best = {taskId:id, es:t.ES};
  }
  return best;
}
const STEP_BUFFER_FRAC = { prevention:0.07, monitoring:0.05, contingency:0.04, evidence:0.04 };

function computeUpperBoundFromAnchors(stepKey, anchors, taskIndex, gateStart, gateEnd){
  const beforeTasks = anchors?.[stepKey]?.beforeTasks || [];
  const a = earliestAnchorES(beforeTasks, taskIndex);
  if(!a) return { ub: gateEnd, anchor:null };
  const gateLen = Math.max(1, gateEnd - gateStart);
  const buffer = Math.max(1, Math.round(gateLen * (STEP_BUFFER_FRAC[stepKey] ?? 0.05)));
  const ub = Math.max(gateStart, Math.min(gateEnd, a.es - buffer));
  return { ub, anchor:{ taskId:a.taskId, es:a.es, buffer } };
}
function solveSLAWithBounds(prelim, upper, gateStart){
  const keys = ["prevention","monitoring","contingency","evidence"];
  const due = {...prelim};
  for(const k of keys) due[k] = Math.max(gateStart, Math.min(due[k], upper[k]));
  for(let i=1;i<keys.length;i++){
    const k = keys[i], prev = keys[i-1];
    due[k] = Math.max(due[k], due[prev]);
    due[k] = Math.min(due[k], upper[k]);
  }
  for(let i=keys.length-1;i>0;i--){
    const k = keys[i], prev = keys[i-1];
    if(due[prev] > due[k]) due[prev] = due[k];
  }
  for(let i=1;i<keys.length;i++){
    const k = keys[i], prev = keys[i-1];
    due[k] = Math.max(due[k], due[prev]);
    due[k] = Math.min(due[k], upper[k]);
  }
  const conflicts = [];
  for(const k of keys) if(due[k] > upper[k]) conflicts.push({step:k, type:"UB_VIOLATION"});
  for(let i=1;i<keys.length;i++) if(due[keys[i]] < due[keys[i-1]]) conflicts.push({step:keys[i], type:"ORDER_CONFLICT"});
  return { due, conflicts };
}
function computeSLADueDatesForRisk(risk, ap, cpm, projectStartDate){
  const projectDuration = (cpm && cpm.ok) ? cpm.projectDuration : 180;
  const gateWin = computeGateWindowsFromCPM(cpm);
  const gate = primaryGate(risk.gate);
  const gw = getGateWindow(gate, gateWin, projectDuration);

  const sla = ap?.sla || {prevention:0.25, monitoring:0.55, contingency:0.75, evidence:0.85};
  const prelim = {
    prevention:  computeDueDayForStep({gateStart:gw.start, gateEnd:gw.end, baseFraction:sla.prevention,  level:risk.level}),
    monitoring:  computeDueDayForStep({gateStart:gw.start, gateEnd:gw.end, baseFraction:sla.monitoring,  level:risk.level}),
    contingency: computeDueDayForStep({gateStart:gw.start, gateEnd:gw.end, baseFraction:sla.contingency, level:risk.level}),
    evidence:    computeDueDayForStep({gateStart:gw.start, gateEnd:gw.end, baseFraction:sla.evidence,    level:risk.level}),
  };

  const taskIndex = indexCPMTasks(cpm);
  const anchors = ap?.anchors || {};
  const upper = {}, anchorsUsed = {};
  for(const step of ["prevention","monitoring","contingency","evidence"]){
    const {ub, anchor} = computeUpperBoundFromAnchors(step, anchors, taskIndex, gw.start, gw.end);
    upper[step] = ub;
    if(anchor) anchorsUsed[step] = anchor;
  }

  const solved = solveSLAWithBounds(prelim, upper, gw.start);
  const dueDays = solved.due;

  const toDateOrOffset = (d) => projectStartDate ? daysToDate(projectStartDate, d) : `Tag+${d}`;
  const dueDates = {
    prevention:  toDateOrOffset(dueDays.prevention),
    monitoring:  toDateOrOffset(dueDays.monitoring),
    contingency: toDateOrOffset(dueDays.contingency),
    evidence:    toDateOrOffset(dueDays.evidence),
  };

  const hardConflicts = [];
  for(const [step, a] of Object.entries(anchorsUsed)){
    if(dueDays[step] >= a.es){
      hardConflicts.push({ step, type:"ANCHOR_NOT_MET", taskId:a.taskId, taskES:a.es, dueDay:dueDays[step] });
    }
  }

  return { gate, window: gw, dueDays, dueDates, anchorsUsed, conflicts: [...(solved.conflicts||[]), ...hardConflicts] };
}

