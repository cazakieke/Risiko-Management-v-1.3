   refs:"DIN EN 50341; DIN EN 60826; DIN VDE 0105-100"},
  {id:"MOD_UMSPANN", group:"scope",
   title:"Umspannwerk / Schaltanlage (AIS/GIS)",
   desc:"Aktiviert Erdung/Schutz, Schaltgeräte (IEC 62271), Abnahmen, TSO/DSO-Interfaces.",
   refs:"DIN EN 61936-1 (VDE 0101-1); DIN EN 50522; IEC 62271"},
  {id:"MOD_THERMO", group:"scope",
   title:"Thermisches Kraftwerk (Bestand/Neubau, z.B. GuD)",
   desc:"Aktiviert Immissionsschutz, Prozess-/Betriebssicherheit und ETS/MRV (projektabhängig).",
   refs:"BImSchG; TA Luft; TA Lärm; TEHG"},
  {id:"MOD_COAL2GAS", group:"scope",
   title:"Konversion Kohle → Gas (Umbau/Repowering)",
   desc:"Fokus auf Umbau im Bestand, Demontage, Altlasten/Asbest, Prozessänderungen und Genehmigungsänderung.",
   refs:"BImSchG; GefStoffV/TRGS; KrWG"},
  {id:"MOD_GAS_CONN", group:"scope",
   title:"Gasanbindung / Gasnetz-Interface",
   desc:"Schnittstelle zum Gasnetz (Druck/Qualität/Kapazität) als potenzieller kritischer Pfad.",
   refs:"EnWG; Betreiberregeln (DVGW je nach Scope)"},
  {id:"MOD_SCADA", group:"scope",
   title:"Leittechnik/SCADA/Telekommunikation (OT)",
