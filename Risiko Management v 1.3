    .kbd { font-family:var(--mono); font-size:11px; color:#dbe6ff; padding:2px 6px; border:1px solid rgba(35,50,85,.8); border-radius:8px; background:rgba(11,19,39,.6); }
  </style>

  <!-- PDF libs (client-side). Offline: download and reference locally -->
