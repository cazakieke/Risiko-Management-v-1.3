   refs:"IEC 62443; ggf. BSIG/BSI-KRITIS"},
  {id:"MOD_DEMO", group:"scope",
   title:"Rückbau/Demontage/Abbruch im Bestand",
   desc:"Aktiviert Abbruch-/Schadstoff-/Entsorgungsanforderungen inkl. TRGS-konformer Prozesse.",
   refs:"GefStoffV/TRGS; KrWG"},

  // permitting
  {id:"PERM_PLANFEST", group:"permitting",
   title:"Planfeststellungsverfahren / Linieninfrastruktur",
   desc:"Genehmigungskette inkl. Einwendungsmanagement (typisch Leitung/Trasse).",
   refs:"EnWG; NABEG; BBPlG (projektabhängig)"},
