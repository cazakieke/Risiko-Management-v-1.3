  <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.5.29/dist/jspdf.plugin.autotable.min.js"></script>
</head>

<body>
<header>
  <div class="brand">
    <div class="logo" aria-label="Logo">
      <img id="brandLogoImg" alt="RISIKO Management Logo"/>
      <!-- fallback svg (if no logo uploaded) -->
      <svg id="brandLogoFallback" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M14 2 5 14h7l-2 8 9-13h-7l2-7Z" fill="#64b5f6"/>
      </svg>
    </div>
    <div>
      <h1>Risikomanagement – Parametrischer Generator (DE)</h1>
      <div class="sub">
        Energieprojekte: Übertragungsleitungen, Umspannwerke, Thermokraftwerke, Kohle→Gas.
        Auswahl per Checkboxen erzeugt Anforderungen, Risiken, Maßnahmen, Terminplan (CPM) und PDF‑Abschlussbericht (SLA + Task‑Anchors).<br/>
        Keine Rechtsberatung.
      </div>
    </div>
  </div>
</header>

<main>

  <div class="tabs card" style="padding:10px 12px;">
    <button class="tab active" data-tab="tab-config">Konfiguration</button>
    <button class="tab" data-tab="tab-req">Anforderungen</button>
    <button class="tab" data-tab="tab-risk">Risiken</button>
    <button class="tab" data-tab="tab-sched">Terminplan</button>
    <button class="tab" data-tab="tab-report">Report/Export</button>
  </div>

  <!-- TAB: CONFIG -->
  <section id="tab-config" class="panel active">
    <div class="grid2" style="margin-top:12px">

      <section class="card">
        <h2>1) Projektkonfiguration</h2>

        <div class="row">
          <label>Projektname<br/>
            <input id="projectName" type="text" placeholder="z.B. Leitung + UW + Kohle→Gas" style="min-width:320px"/>
          </label>
          <label>Projektstart (CPM &amp; SLA)<br/>
            <input id="projectStart" type="date"/>
          </label>
          <label>Risikobewertung – Schwellen<br/>
            <select id="thresholdPreset">
              <option value="default" selected>Standard (1–4 niedrig, 5–9 mittel, 10–16 hoch, 17–25 kritisch)</option>
              <option value="conservative">Konservativ (1–3 niedrig, 4–8 mittel, 9–15 hoch, 16–25 kritisch)</option>
            </select>
          </label>
        </div>

        <div class="tools" style="margin-top:10px">
          <button id="btnGenerate">Generieren / Aktualisieren</button>
          <button class="secondary" id="btnSave">Speichern</button>
          <button class="secondary" id="btnLoad">Laden</button>
          <button class="secondary" id="btnReset">Reset</button>
        </div>

        <fieldset>
          <legend>Branding (Logo &amp; Favicon)</legend>
          <div class="muted">
            Laden Sie Ihr Logo (PNG/JPG) hoch. Es wird lokal gespeichert (<span class="kbd">localStorage</span>) und automatisch in den PDF‑Report übernommen.
          </div>
          <div class="row" style="margin-top:10px">
            <label>Logo hochladen<br/>
              <input id="logoUpload" type="file" accept="image/*" />
            </label>
            <button class="secondary" id="btnClearLogo">Logo entfernen</button>
          </div>
          <div class="small" style="margin-top:8px">
            Empfehlung: quadratisches Logo (z.B. 512×512). Das System skaliert automatisch.
          </div>
        </fieldset>

        <fieldset>
          <legend>Module / Umfang</legend>
          <div class="checks" id="group_scope"></div>
        </fieldset>

        <fieldset>
          <legend>Genehmigungen / Verfahren</legend>
          <div class="checks" id="group_permitting"></div>
        </fieldset>

        <fieldset>
          <legend>Umwelt / Raum</legend>
          <div class="checks" id="group_environment"></div>
        </fieldset>

        <fieldset>
          <legend>Prozess-/Anlagensicherheit &amp; Industrie</legend>
          <div class="checks" id="group_process"></div>
        </fieldset>

        <fieldset>
          <legend>Netz / Betrieb / OT-IT</legend>
          <div class="checks" id="group_grid"></div>
        </fieldset>

        <fieldset>
          <legend>Bau / HSE</legend>
          <div class="checks" id="group_hse"></div>
        </fieldset>

        <div class="footer-note">
          Tipp: Ändern Sie <b>Dauer</b> im Terminplan und klicken Sie dann <b>Generieren</b>, um CPM + SLA neu zu berechnen.
