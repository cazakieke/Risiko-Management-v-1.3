/* =========================
   Render tables
   ========================= */
function renderRequirements(reqs){
  const tbody = document.querySelector("#tblReq tbody");
  tbody.innerHTML = "";
  reqs.forEach(r=>{
    tbody.appendChild(el("tr",{},
      el("td",{}, el("span",{class:"mono"}, r.id)),
      el("td",{}, r.theme),
      el("td",{}, r.ref),
      el("td",{}, r.desc),
      el("td",{}, r.deliverables),
      el("td",{}, el("span",{class:"mono"}, [...(r.all||[]), ...(r.any||[])].join(", ")))
    ));
  });
  if(reqs.length===0){
    tbody.appendChild(el("tr",{}, el("td",{colspan:"6", class:"muted"}, "Keine Anforderungen aktiv (bitte Merkmale auswählen).")));
  }
}

function renderRisks(risks, thresholdPreset){
  const tbody = document.querySelector("#tblRisk tbody");
  tbody.innerHTML = "";
  risks.forEach(r=>{
    const ap = findActionPlan(r.ap) || {prevention:"—", monitoring:"—", contingency:"—", owner:"—"};
    const reqChips = (r.req||[]).map(x=>`<span class="chip mono">${x}</span>`).join(" ");
    const score = r.p * r.i;
    const lvl = riskLevel(score, thresholdPreset);

    tbody.appendChild(el("tr",{},
      el("td",{}, el("span",{class:"mono"}, r.id)),
      el("td",{}, r.cat),
      el("td",{}, r.risk),
      el("td",{}, r.cause),
      el("td",{html:reqChips || "—"}),
      el("td",{}, el("input",{type:"number", min:"1", max:"5", step:"1", value:String(r.p), id:`p_${r.id}`, "data-risk":r.id})),
      el("td",{}, el("input",{type:"number", min:"1", max:"5", step:"1", value:String(r.i), id:`i_${r.id}`, "data-risk":r.id})),
      el("td",{id:`score_${r.id}`}, String(score)),
      el("td",{id:`lvl_${r.id}`}, el("span",{class:`lvl ${lvl.cls}`}, lvl.lvl)),
      el("td",{}, ap.prevention),
      el("td",{}, ap.monitoring),
      el("td",{}, ap.contingency),
      el("td",{}, ap.owner),
      el("td",{}, r.gate || "—")
    ));
  });

  if(risks.length===0){
    tbody.appendChild(el("tr",{}, el("td",{colspan:"14", class:"muted"}, "Keine Risiken aktiv (bitte Merkmale auswählen).")));
  }

  tbody.querySelectorAll('input[type="number"]').forEach(inp=>{
    inp.addEventListener("input", ()=>{
      const rid = inp.getAttribute("data-risk");
      const p = Math.max(1, Math.min(5, Number(document.getElementById(`p_${rid}`).value || 1)));
      const i = Math.max(1, Math.min(5, Number(document.getElementById(`i_${rid}`).value || 1)));
      const sc = p*i;
      document.getElementById(`score_${rid}`).textContent = String(sc);
      const lv = riskLevel(sc, document.getElementById("thresholdPreset").value);
      const cell = document.getElementById(`lvl_${rid}`);
      cell.innerHTML = "";
      cell.appendChild(el("span",{class:`lvl ${lv.cls}`}, lv.lvl));
    });
  });
}

function cloneTasksWithOverrides(appTasks){
  const overrides = new Map();
  document.querySelectorAll('#tblSched input[type="number"][id^="dur_"]').forEach(inp=>{
    const id = inp.getAttribute("data-task");
    const v = Number(inp.value);
    if(id && !Number.isNaN(v)) overrides.set(id, v);
  });
  return appTasks.map(t => ({...t, dur: overrides.has(t.id) ? overrides.get(t.id) : t.dur}));
}

function renderSchedule(appTasks, startDate){
  const tbody = document.querySelector("#tblSched tbody");
  tbody.innerHTML = "";
  const cpm = computeCPM(appTasks);
  const note = document.getElementById("schedNote");

  if(!cpm.ok){
    note.innerHTML = `<span style="color:#ffb4ad;font-weight:950">CPM-Fehler:</span> ${cpm.error}`;
    tbody.appendChild(el("tr",{}, el("td",{colspan:"14", class:"muted"}, "Terminplan konnte nicht berechnet werden.")));
    return {cpm:null};
  }

  const projDur = cpm.projectDuration;
  const endDate = startDate ? daysToDate(startDate, projDur) : "—";
  note.innerHTML = `Netto-Dauer: <span class="mono">${projDur}</span> Tage | Start: <span class="mono">${startDate||"—"}</span> | Ende: <span class="mono">${endDate}</span>`;

  for(const t of cpm.tasks){
    const isCrit = t.Critical;
    const durInput = el("input",{type:"number", min:"0", step:"1", value:String(t.dur), id:`dur_${t.id}`, "data-task":t.id});
    const ESd = startDate ? daysToDate(startDate, t.ES) : String(t.ES);
    const EFd = startDate ? daysToDate(startDate, t.EF) : String(t.EF);
    const LSd = startDate ? daysToDate(startDate, t.LS) : String(t.LS);
    const LFd = startDate ? daysToDate(startDate, t.LF) : String(t.LF);

    tbody.appendChild(el("tr",{class:isCrit ? "critical-row":""},
      el("td",{}, el("span",{class:"mono"}, t.id)),
      el("td",{}, t.name),
      el("td",{}, t.module),
      el("td",{}, durInput),
      el("td",{}, el("span",{class:"mono"}, (t.pred||[]).join(";") || "—")),
      el("td",{}, el("span",{class:"mono"}, ESd)),
      el("td",{}, el("span",{class:"mono"}, EFd)),
      el("td",{}, el("span",{class:"mono"}, LSd)),
      el("td",{}, el("span",{class:"mono"}, LFd)),
      el("td",{}, el("span",{class:"mono"}, String(t.Float))),
      el("td",{}, isCrit ? el("span",{class:"lvl crit"}, "JA") : el("span",{class:"lvl low"}, "NEIN")),
      el("td",{}, t.deliver || "—"),
      el("td",{}, t.owner || "—"),
      el("td",{}, t.gate || "—")
    ));
  }
  return {cpm};
}

/* =========================
   Generate pipeline
   ========================= */
function generate(){
  const selected = getSelectedFeatureSet();
  const active = [...selected].sort();
  document.getElementById("activeFeatures").innerHTML = active.length
    ? active.map(x=>`<span class="chip mono">${x}</span>`).join(" ")
    : "—";

  const reqs  = REQUIREMENTS.filter(r=>isApplicable(r, selected));
  const risks = RISKS.filter(r=>isApplicable(r, selected)).map(r=>({...r}));
  const tasksRaw = TASKS.filter(t=>isApplicable(t, selected)).map(t=>({...t}));
  const tasks = cloneTasksWithOverrides(tasksRaw);

  const preset = document.getElementById("thresholdPreset").value;
  renderRequirements(reqs);
  renderRisks(risks, preset);

  const startDate = document.getElementById("projectStart").value;
  const sched = renderSchedule(tasks, startDate);

  document.getElementById("counts").innerHTML = `
    <div>Aktive Anforderungen: <span class="mono">${reqs.length}</span></div>
    <div>Aktive Risiken: <span class="mono">${risks.length}</span></div>
    <div>Aktive Aufgaben (WBS): <span class="mono">${tasks.length}</span></div>
  `;

  window.__GEN__ = {
    selected:[...selected],
    requirements:reqs,
    risks:risks,
    tasks:tasks,
    cpm: sched.cpm,
    project:{
      name: document.getElementById("projectName").value || "",
      start: document.getElementById("projectStart").value || "",
      thresholdPreset: preset
    }
  };
}
document.getElementById("btnGenerate").addEventListener("click", generate);

/* =========================
   Save/Load config
   ========================= */
const CFG_KEY = "riskMatrixConfigDE_tabs_v2";
function saveConfig(){
  const cfg = {
    projectName: document.getElementById("projectName").value || "",
    projectStart: document.getElementById("projectStart").value || "",
    thresholdPreset: document.getElementById("thresholdPreset").value || "default",
    selected: [...getSelectedFeatureSet()]
  };
  localStorage.setItem(CFG_KEY, JSON.stringify(cfg));
  alert("Gespeichert.");
}
function loadConfig(){
  const raw = localStorage.getItem(CFG_KEY);
  if(!raw){ alert("Keine gespeicherte Konfiguration gefunden."); return; }
  const cfg = JSON.parse(raw);
  document.getElementById("projectName").value = cfg.projectName || "";
  document.getElementById("projectStart").value = cfg.projectStart || "";
  document.getElementById("thresholdPreset").value = cfg.thresholdPreset || "default";
  const set = new Set(cfg.selected || []);
  FEATURES.forEach(f=>{
    const chk = document.getElementById("chk_"+f.id);
    if(chk) chk.checked = set.has(f.id);
  });
  generate();
}
function resetConfig(){
  document.getElementById("projectName").value = "";
  document.getElementById("projectStart").value = "";
  document.getElementById("thresholdPreset").value = "default";
  FEATURES.forEach(f=>{
    const chk = document.getElementById("chk_"+f.id);
    if(chk) chk.checked = false;
  });
  generate();
}
document.getElementById("btnSave").addEventListener("click", saveConfig);
document.getElementById("btnLoad").addEventListener("click", loadConfig);
document.getElementById("btnReset").addEventListener("click", resetConfig);

/* =========================
   Export helpers (CSV/JSON)
   ========================= */
function download(filename, text){
  const blob = new Blob([text], {type:"text/plain;charset=utf-8"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}
function toCSV(rows, headers){
  const esc = (v) => {
    const s = (v==null) ? "" : String(v);
    if(/[",\n]/.test(s)) return `"${s.replaceAll('"','""')}"`;
    return s;
  };
  const head = headers.map(esc).join(",");
  const lines = rows.map(r => headers.map(h=>esc(r[h])).join(","));
  return [head, ...lines].join("\n");
}
function exportReq(){
  const gen = window.__GEN__ || {};
  const rows = (gen.requirements||[]).map(r=>({
    ID:r.id, Thema:r.theme, Referenz:r.ref, Zweck:r.desc, Evidenzen:r.deliverables
  }));
  download("Anforderungen.csv", toCSV(rows, ["ID","Thema","Referenz","Zweck","Evidenzen"]));
}
function exportRisk(){
  const gen = window.__GEN__ || {};
  const preset = document.getElementById("thresholdPreset").value;
  const rows = (gen.risks||[]).map(r=>{
    const p = Number(document.getElementById(`p_${r.id}`)?.value ?? r.p);
    const i = Number(document.getElementById(`i_${r.id}`)?.value ?? r.i);
    const score = p*i;
    const lv = riskLevel(score, preset).lvl;
    const ap = findActionPlan(r.ap) || {};
    return {
      ID:r.id, Kategorie:r.cat, Risiko:r.risk, Ursache:r.cause,
      Anforderungen:(r.req||[]).join(";"),
      P:p, I:i, Score:score, Stufe:lv,
      Praevention:ap.prevention||"", Monitoring:ap.monitoring||"", Kontingenz:ap.contingency||"",
      Owner:ap.owner||"", Gate:r.gate||""
    };
  });
  download("Risiken.csv", toCSV(rows, ["ID","Kategorie","Risiko","Ursache","Anforderungen","P","I","Score","Stufe","Praevention","Monitoring","Kontingenz","Owner","Gate"]));
}
function exportSched(){
  const gen = window.__GEN__ || {};
  const start = document.getElementById("projectStart").value;
  const tasks = (gen.tasks||[]).map(t=>{
    const dur = Number(document.getElementById(`dur_${t.id}`)?.value ?? t.dur);
    return {...t, dur};
  });
  const cpm = computeCPM(tasks);
  const rows = (cpm.ok ? cpm.tasks : tasks).map(t=>({
    ID:t.id, Taetigkeit:t.name, Modul:t.module, Dauer_Tage:t.dur,
    Vorgaenger:(t.pred||[]).join(";"),
    ES: start ? daysToDate(start, t.ES||0) : (t.ES||0),
    EF: start ? daysToDate(start, t.EF||0) : (t.EF||0),
    Float:(t.Float!=null ? t.Float : ""),
    Kritisch:(t.Critical ? "JA":"NEIN"),
    Gate:t.gate||""
  }));
  download("Terminplan_CPM.csv", toCSV(rows, ["ID","Taetigkeit","Modul","Dauer_Tage","Vorgaenger","ES","EF","Float","Kritisch","Gate"]));
}
function exportJSON(){
  const gen = window.__GEN__ || {};
  const preset = document.getElementById("thresholdPreset").value;
  const start = document.getElementById("projectStart").value || "";

  const tasks = (gen.tasks||[]).map(t=>{
    const dur = Number(document.getElementById(`dur_${t.id}`)?.value ?? t.dur);
    return {...t, dur};
  });
  const cpm = computeCPM(tasks);

  const risks = (gen.risks||[]).map(r=>{
    const p = Math.max(1, Math.min(5, Number(document.getElementById(`p_${r.id}`)?.value ?? r.p)));
    const i = Math.max(1, Math.min(5, Number(document.getElementById(`i_${r.id}`)?.value ?? r.i)));
    const score = p*i;
    const level = riskLevel(score, preset).lvl;
    const ap = findActionPlan(r.ap) || {};
    const obj = {...r, p,i,score, level, action: ap};
    obj.sla = computeSLADueDatesForRisk(obj, ap, cpm, start);
    return obj;
  });

  const branding = loadBranding();
  download("Risikomatrix_Export.json", JSON.stringify({
    ...gen, tasks, cpm, risks, branding, exportedAt: new Date().toISOString()
  }, null, 2));
}

document.getElementById("btnExportReq").addEventListener("click", exportReq);
document.getElementById("btnExportRisk").addEventListener("click", exportRisk);
document.getElementById("btnExportSched").addEventListener("click", exportSched);
document.getElementById("btnExportJSON").addEventListener("click", exportJSON);

/* =========================
   PDF report (logo included)
   ========================= */
function collectStateForReport(){
  const gen = window.__GEN__ || {selected:[], requirements:[], risks:[], tasks:[], project:{}, cpm:null};
  const preset = document.getElementById("thresholdPreset").value;
  const start = document.getElementById("projectStart").value || "";

  const tasks = (gen.tasks||[]).map(t=>{
    const dur = Number(document.getElementById(`dur_${t.id}`)?.value ?? t.dur);
    return {...t, dur};
  });
  const cpm = computeCPM(tasks);

  const risks = (gen.risks||[]).map(r=>{
    const p = Math.max(1, Math.min(5, Number(document.getElementById(`p_${r.id}`)?.value ?? r.p)));
    const i = Math.max(1, Math.min(5, Number(document.getElementById(`i_${r.id}`)?.value ?? r.i)));
    const score = p*i;
    const level = riskLevel(score, preset).lvl;
    const ap = findActionPlan(r.ap) || {};
    const ro = { id:r.id, cat:r.cat, risk:r.risk, cause:r.cause, req:(r.req||[]), p,i,score, level, gate:r.gate||"—", action: ap };
    ro.sla = computeSLADueDatesForRisk(ro, ap, cpm, start);
    return ro;
  }).sort((a,b)=> b.score - a.score);

  return {
    project:{
      name:(document.getElementById("projectName").value || gen.project?.name || "").trim(),
      startDate:start,
      thresholdPreset:preset
    },
    selected: gen.selected || [],
    requirements: gen.requirements || [],
    risks,
    tasks,
    cpm,
    branding: loadBranding()
  };
}

function exportPDFReport(){
  if(!window.jspdf || !window.jspdf.jsPDF){
    alert("jsPDF nicht geladen.");
    return;
  }
  const state = collectStateForReport();
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({orientation:"p", unit:"pt", format:"a4"});
  const pageW = doc.internal.pageSize.getWidth();
  const pageH = doc.internal.pageSize.getHeight();
  const margin = 40;

  const addHeader = (title) => {
    // logo (if present)
    const logoDataUrl = state.branding?.logoDataUrl;
    if(logoDataUrl){
      const type = guessImageTypeFromDataUrl(logoDataUrl) || "PNG";
      try { doc.addImage(logoDataUrl, type, margin, 28, 34, 34); } catch(e) { /* ignore */ }
    }
    const xTitle = logoDataUrl ? margin + 44 : margin;

    doc.setFont("helvetica","bold"); doc.setFontSize(14); doc.setTextColor(20,30,60);
    doc.text(title, xTitle, 46);

    doc.setFont("helvetica","normal"); doc.setFontSize(9); doc.setTextColor(120,130,150);
    doc.text(
      `Projekt: ${state.project.name||"—"} | Start: ${state.project.startDate||"—"} | Preset: ${state.project.thresholdPreset} | Report: ${new Date().toLocaleString("de-DE")}`,
      xTitle, 62
    );
    doc.setDrawColor(200,205,220); doc.line(margin, 72, pageW-margin, 72);
  };

  addHeader("Risikomanagement – Abschlussbericht");
  let y = 90;

  doc.setFont("helvetica","bold"); doc.setFontSize(11); doc.setTextColor(15,25,55);
  doc.text("1) Aktivierte Merkmale", margin, y); y += 14;

  doc.setFont("helvetica","normal"); doc.setFontSize(9); doc.setTextColor(40,50,80);
  const featLines = doc.splitTextToSize((state.selected.length?state.selected.join(", "):"—"), pageW-2*margin);
  doc.text(featLines, margin, y); y += featLines.length*11 + 12;

  doc.setFont("helvetica","bold"); doc.setFontSize(11); doc.setTextColor(15,25,55);
  doc.text("2) Risikoübersicht (priorisiert)", margin, y); y += 8;

  doc.autoTable({
    startY: y + 6,
    head: [["ID","Kategorie","Stufe","P","I","Score","Owner","Gate"]],
    body: state.risks.length
      ? state.risks.map(r=>[r.id, r.cat, r.level, String(r.p), String(r.i), String(r.score), r.action?.owner||"—", r.gate||"—"])
      : [["—","—","—","—","—","—","—","—"]],
    styles: { fontSize: 8, cellPadding: 4 },
    headStyles: { fillColor: [15,25,55] },
    margin: {left:margin, right:margin},
    didParseCell: (data)=>{
      if(data.section==="body" && data.column.index===2){
        const lvl = data.cell.text?.[0] || "";
        const c = levelColor(lvl);
        data.cell.styles.textColor = c;
        data.cell.styles.fontStyle = "bold";
      }
    }
  });

  doc.addPage(); addHeader("Risikomanagement – Abschlussbericht");
  y = 90;

  doc.setFont("helvetica","bold"); doc.setFontSize(11); doc.setTextColor(15,25,55);
  doc.text("3) Detailanalyse je Risiko (SLA + Anchors)", margin, y); y += 10;

  for(const r of state.risks){
    if(y > pageH - margin - 170){ doc.addPage(); addHeader("Risikomanagement – Abschlussbericht"); y = 90; }

    const c = levelColor(r.level);
    doc.setFont("helvetica","bold"); doc.setFontSize(10); doc.setTextColor(c[0],c[1],c[2]);
    doc.text(`${r.id} | ${r.level} | Score ${r.score} (P=${r.p}, I=${r.i})`, margin, y); y += 12;

    doc.setFont("helvetica","bold"); doc.setFontSize(9); doc.setTextColor(15,25,55);
    doc.text("Risiko:", margin, y);
    doc.setFont("helvetica","normal"); doc.setTextColor(40,50,80);
    let lines = doc.splitTextToSize(r.risk, pageW-2*margin-45);
    doc.text(lines, margin+45, y); y += Math.max(12, lines.length*11);

    doc.setFont("helvetica","bold"); doc.setTextColor(15,25,55);
    doc.text("Ursache:", margin, y);
    doc.setFont("helvetica","normal"); doc.setTextColor(40,50,80);
    lines = doc.splitTextToSize(r.cause||"—", pageW-2*margin-55);
    doc.text(lines, margin+55, y); y += Math.max(12, lines.length*11);

    const blocks = [
      {k:"prevention",  t:"Prävention",  x:r.action?.prevention||"—"},
      {k:"monitoring",  t:"Monitoring",  x:r.action?.monitoring||"—"},
      {k:"contingency", t:"Kontingenz",  x:r.action?.contingency||"—"},
      {k:"evidence",    t:"Evidenzen",   x:r.action?.evidence||"—"},
    ];

    for(const b of blocks){
      if(y > pageH - margin - 90){ doc.addPage(); addHeader("Risikomanagement – Abschlussbericht"); y = 90; }
      const due = r.sla?.dueDates?.[b.k] || "—";
      const gate = r.sla?.gate || primaryGate(r.gate);
      const anchor = r.sla?.anchorsUsed?.[b.k];
      const anchorTxt = anchor ? ` | Anker: ${anchor.taskId} (ES=${anchor.es}, Buffer=${anchor.buffer}d)` : "";
      doc.setFont("helvetica","bold"); doc.setTextColor(15,25,55);
      doc.text(`${b.t} (Fällig bis: ${due} | Gate: ${gate}${anchorTxt})`, margin, y);
      doc.setFont("helvetica","normal"); doc.setTextColor(40,50,80);
      lines = doc.splitTextToSize(b.x, pageW-2*margin);
      doc.text(lines, margin, y+12);
      y += 12 + lines.length*11 + 6;
    }

    doc.setDrawColor(210,215,228);
    doc.line(margin, y, pageW-margin, y);
    y += 12;
  }

  const pageCount = doc.getNumberOfPages();
  for(let i=1;i<=pageCount;i++){
    doc.setPage(i);
    doc.setFont("helvetica","normal"); doc.setFontSize(8); doc.setTextColor(120,130,150);
    doc.text(`Seite ${i}/${pageCount}`, pageW - margin, pageH - 20, {align:"right"});
  }

  const safeName = (state.project.name || "Risikomatrix").replace(/[^\w\-]+/g,"_").slice(0,60);
  doc.save(`${safeName}_Abschlussbericht.pdf`);
}
document.getElementById("btnExportPDF").addEventListener("click", exportPDFReport);

/* =========================
   Init + defaults
   ========================= */
(function init(){
  // apply branding (logo) if present
  const branding = loadBranding();
  applyLogoToHeader(branding.logoDataUrl || null);

  const today = new Date().toISOString().slice(0,10);
  document.getElementById("projectStart").value = today;

  // optional defaults
  ["GRID_TSO","HSE_BAUSTELLV"].forEach(id=>{
    const chk = document.getElementById("chk_"+id);
    if(chk) chk.checked = true;
  });

  generate();
})();
</script>
