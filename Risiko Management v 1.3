function renderCheckboxGroups(){
  const containers = {
    scope: document.getElementById("group_scope"),
    permitting: document.getElementById("group_permitting"),
    environment: document.getElementById("group_environment"),
    process: document.getElementById("group_process"),
    grid: document.getElementById("group_grid"),
    hse: document.getElementById("group_hse")
  };
  Object.values(containers).forEach(c=>c.innerHTML="");

  FEATURES.forEach(f=>{
    const id = "chk_"+f.id;
    const box = el("input",{type:"checkbox", id});
    const content = el("div",{},
      el("div",{class:"t"}, f.title),
      el("div",{class:"d"}, f.desc || ""),
      f.refs ? el("div",{class:"r"}, "Referenzen: " + f.refs) : null,
      el("div",{class:"code"}, f.id)
    );
    const wrap = el("label",{class:"check", for:id}, box, content);
    containers[f.group].appendChild(wrap);
  });
}
